{
  "name": "friend-point-development",
  "version": "0.1.0",
  "private": true,
  "description": "Punto Amigo — plataforma de intermediacion de servicios locales. Backend en microservicios y cliente web PWA.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "typecheck": "tsc --build --verbose",
    "test": "jest --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "db:migrate": "node db/cli.js migrate",
    "db:rollback": "node db/cli.js rollback",
    "db:seed": "node db/cli.js seed",
    "db:reset": "node db/cli.js reset",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run audit"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.17.9",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "knex": "3.1.0",
    "mysql2": "3.24.5",
    "@node-rs/argon2": "2.0.2"
  }
}
