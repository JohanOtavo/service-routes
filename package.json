{
  "name": "friend-point-development",
  "version": "0.1.0",
  "private": true,
  "description": "Punto Amigo — plataforma de intermediacion de servicios locales. Backend en microservicios y cliente web PWA.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "typecheck": "tsc --build --verbose && tsc -p apps/web && tsc -p e2e",
    "test": "jest --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:web": "npm run test --workspace apps/web",
    "e2e": "playwright test",
    "e2e:instalar": "playwright install --with-deps chromium",
    "db:migrate": "node db/cli.js migrate",
    "db:rollback": "node db/cli.js rollback",
    "db:seed": "node db/cli.js seed",
    "db:reset": "node db/cli.js reset",
    "db:reemit": "node db/cli.js reemit",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:web && npm run audit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.17.9",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "jest": "^30.5.2",
    "prettier": "3.4.2",
    "sharp": "^0.35.5",
    "ts-jest": "^29.4.14",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "dotenv": "16.4.7",
    "knex": "3.1.0",
    "mysql2": "3.24.5"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
