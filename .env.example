# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno para desarrollo local (Punto Amigo)
#
# USO: cp .env.example .env
#
# NUNCA commitear .env con valores reales. Los valores de staging y produccion
# viven en el gestor de secretos, jamas en el repositorio.
#
# Corrige el .env.example heredado de la plantilla, que declaraba PostgreSQL,
# el puerto 8081 y BCRYPT_ROUNDS=10 — por debajo del minimo que exige
# 00-governance/security-rules.md.
# ─────────────────────────────────────────────────────────────────────────────

# ─── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
# Origen unico permitido por CORS. En produccion NUNCA usar "*".
CORS_ORIGIN=http://localhost:5173

# ─── MySQL: raiz solo para bootstrap local ────────────────────────────────────
# El contenedor crea los 7 esquemas y un usuario por servicio con privilegio
# minimo (db/init/01-schemas-and-users.sql). Ningun servicio usa root.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=local-root-only-change-me

# ─── Credenciales por servicio (una por esquema, privilegio minimo) ───────────
DB_AUTH_USER=pa_auth_svc
DB_AUTH_PASSWORD=local-auth-change-me
DB_PROVIDER_USER=pa_provider_svc
DB_PROVIDER_PASSWORD=local-provider-change-me
DB_CATALOG_USER=pa_catalog_svc
DB_CATALOG_PASSWORD=local-catalog-change-me
DB_REQUEST_USER=pa_request_svc
DB_REQUEST_PASSWORD=local-request-change-me
DB_RATING_USER=pa_rating_svc
DB_RATING_PASSWORD=local-rating-change-me
DB_NOTIFICATION_USER=pa_notification_svc
DB_NOTIFICATION_PASSWORD=local-notification-change-me
DB_ADMIN_USER=pa_admin_svc
DB_ADMIN_PASSWORD=local-admin-change-me

# ─── Puertos de los servicios ─────────────────────────────────────────────────
GATEWAY_PORT=8080
AUTH_PORT=3001
PROVIDER_PORT=3002
CATALOG_PORT=3003
REQUEST_PORT=3004
RATING_PORT=3005
NOTIFICATION_PORT=3006
ADMIN_PORT=3007
WEB_PORT=5173

# ─── Autenticacion ────────────────────────────────────────────────────────────
# Argon2id es el algoritmo elegido (SRS RNF21). Parametros OWASP: 19 MiB, t=2, p=1.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# JWT RS256. Generar con:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n[REEMPLAZAR]\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n[REEMPLAZAR]\n-----END PUBLIC KEY-----"

# Access token de vida corta (15 min) y refresh rotativo de 7 dias, en cookie
# httpOnly/Secure/SameSite=Strict. Decision del brief de construccion; el SRS
# RNF22 lo dejaba "por definir" y la plantilla heredada decia 3600.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=pa_refresh
# En local sin HTTPS puede requerir false; en cualquier entorno desplegado: true.
REFRESH_COOKIE_SECURE=false

# Token de recuperacion de contrasena: un solo uso, vigencia corta.
PASSWORD_RECOVERY_TTL_SECONDS=1800

# ─── Bloqueo progresivo por intentos fallidos ─────────────────────────────────
# No estaba en el SRS; se documenta como RF propuesto.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_SECONDS=30
LOGIN_LOCKOUT_MAX_SECONDS=3600
LOGIN_ATTEMPT_WINDOW_SECONDS=900

# ─── Seeds de desarrollo ──────────────────────────────────────────────────────
# Contrasena de las cuentas de prueba. Solo se usa con NODE_ENV=development|test.
# No se versiona ningun hash: el seed lo calcula en tiempo de ejecucion.
SEED_DEV_PASSWORD=PuntoAmigo.Dev.2026

# ─── Redis (limite de tasa y lista de denegacion de tokens) ──────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD= (vacio en local)

# ─── RabbitMQ (eventos de dominio) ────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=pa_dev
RABBITMQ_PASSWORD=local-rabbit-change-me
RABBITMQ_EXCHANGE=punto-amigo.events
# Reintentos antes de derivar a la cola de mensajes fallidos (SRS RF96).
BROKER_MAX_RETRIES=5

# ─── Limites de peticion ──────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=100
RATE_LIMIT_MAX_PER_USER=300
# Limite mas estricto en autenticacion (SRS RNF31).
RATE_LIMIT_AUTH_MAX=10
REQUEST_BODY_LIMIT=100kb
UPLOAD_MAX_BYTES=5242880

# ─── Reglas de negocio configurables ──────────────────────────────────────────
# SRS RF125: limite de necesidades simultaneamente abiertas por usuario.
MAX_OPEN_NEEDS_PER_USER=5
# SRS RNF86: limite de propuestas por ventana de tiempo.
MAX_PROPOSALS_PER_WINDOW=20
PROPOSAL_WINDOW_SECONDS=86400
# Vigencia por defecto de una necesidad, en dias (decision T-07, pendiente).
DEFAULT_NEED_VALIDITY_DAYS=14
# SRS RF166: plazo para que ambas partes califiquen antes de revelar.
RATING_BLIND_PERIOD_DAYS=14

# ─── Autenticacion entre servicios ────────────────────────────────────────────
# Decision T-04: secreto compartido en local; mTLS o JWT interno en produccion.
INTERNAL_SERVICE_SECRET=local-internal-change-me

# ─── Interno del gateway ──────────────────────────────────────────────────────
GATEWAY_UPSTREAM_TIMEOUT_MS=2000
